DATABASE_URL=sqlite:///./task_manager.db
# Supabase: lấy URL từ Dashboard > Connect > Direct connection hoặc Session pooler.
# Dán vào DATABASE_URL phía trên và thêm ?sslmode=require (hoặc &sslmode=require nếu URL đã có tham số).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_MODE=openai
AI_MAX_REQUESTS_PER_HOUR=30
COOKIE_SECURE=false
